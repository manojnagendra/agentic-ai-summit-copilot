{
  "name": "agentic-ai-summit-copilot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5174",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
