    "@types/react-dom": "^19.1.5",
    "@vercel/node": "^5.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vercel": "^58.4.4",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
